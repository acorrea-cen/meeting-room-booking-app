# ----------------------------------------------------------------------------
# Database (Supabase / PostgreSQL)
# ----------------------------------------------------------------------------
# DATABASE_URL  -> usado por la app en runtime (transaction pooler, puerto 6543)
#                  Requiere ?pgbouncer=true&connection_limit=1 para que Prisma
#                  funcione bien con el pooler en modo transaction.
# DIRECT_URL    -> usado por Prisma para migraciones (session pooler / direct,
#                  puerto 5432). NO lleva ?pgbouncer=true.
#
# Copiá las URLs desde:
#   Supabase Dashboard -> botón "Connect" -> pestaña ORMs -> Prisma
# y reemplazá [YOUR-PASSWORD] con la contraseña de tu base.
#
# Si el puerto 6543 está bloqueado en tu red, podés usar el session pooler
# (5432) también para DATABASE_URL, pero SIN ?pgbouncer=true.
# ----------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Realtime (cliente del browser - actualizaciones en vivo del calendario)
# Project Settings -> API:
#   Project URL  -> NEXT_PUBLIC_SUPABASE_URL
#   anon public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Dominio permitido para registro/login
ALLOWED_EMAIL_DOMAIN="censys.com.ar"
